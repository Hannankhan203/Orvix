{
  "name": "orvix",
  "description": "Orvix - A modern, lightweight AI chatbot web application.",
  "private": true,
  "version": "5.3.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:js": "tsc -p tsconfig.checkjs.json --noEmit",
    "audit": "bun audit",
    "audit:json": "bun audit --json",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:e2e": "playwright test --reporter=list",
    "test:e2e:desktop": "playwright test --project=desktop-chromium --reporter=list",
    "test:e2e:mobile": "playwright test --project=mobile-chromium --reporter=list"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@fe-daily/gifsicle-wasm-browser": "^1.5.23",
    "@google/genai": "^2.32.0",
    "@jsquash/oxipng": "^2.3.0",
    "@mlc-ai/web-llm": "0.2.86",
    "@sentry/node": "^11.15.0",
    "@sentry/react": "^11.15.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cfb": "^1.2.2",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "fflate": "^0.8.3",
    "firebase": "11.4.0",
    "firebase-admin": "^14.5.1",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.21.0",
    "unpdf": "^1.9.1",
    "vite": "^8.3.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.0",
    "wasm-feature-detect": "1.8.0",
    "express": {
      "body-parser": "~1.20.9"
    },
    "@grpc/grpc-js": "^1.14.7",
    "katex": "$katex",
    "workbox-build": {
      "glob": "^14.0.6"
    },
    "google-gax": {
