{
  "name": "orvix",
  "description": "Orvix - A modern, lightweight AI chatbot web application.",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:mongo": "tsx scripts/testMongoConnection.ts",
    "test:repositories": "tsx scripts/testMongoRepositories.ts",
    "test:backend": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testBackendIntegration.ts",
    "test:auth": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testFirebaseAuth.ts",
    "test:admin-creds": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testFirebaseAdminCredentials.ts",
    "test:mongo-api": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testAuthenticatedMongoApi.ts",
    "test:profile": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testUserProfileMigration.ts",
    "test:settings": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testUserSettingsMigration.ts",
    "test:conversation": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testConversationMigration.ts",
    "test:messages": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testMessageMigration.ts",
    "test:ai-regression": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testAiProviderAuthRegression.ts",
    "test:stop-lifecycle": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testStopResponseLifecycle.ts",
    "test:sidebar-a11y": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testSidebarAccessibility.ts",
    "test:legacy-discovery": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testLegacyConversationDiscovery.ts",
    "test:token-refresh": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testAuthenticatedTokenRefresh.ts",
    "test:no-fallback": "tsx --import \"data:text/javascript,process.env.TESTING=true\" scripts/testDatabaseNoFallback.ts",
    "test:serverless": "tsx scripts/testVercelServerlessRouting.ts",
    "test": "npm run lint && node scripts/auditOfflineReliability.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@mlc-ai/web-llm": "^0.2.86",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "firebase": "11.4.0",
    "firebase-admin": "^14.5.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "mongodb": "^7.7.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.9.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
